# Language only. Never sees prices, floors, or belief state.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# WhatsApp Business Cloud API + Meta Commerce Manager
# Set up: create a Meta app, add WhatsApp, create a catalog in Commerce
# Manager, connect the catalog to your WABA phone number.
META_ACCESS_TOKEN=
META_CATALOG_ID=
META_APP_SECRET=
WA_PHONE_NUMBER_ID=
WA_PHONE_E164=
WA_VERIFY_TOKEN=choose-any-string-and-paste-it-into-the-meta-webhook-form

HAGGLE_DB=haggle.db
